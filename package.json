{
  "name": "proyecto-trazabilidad-frontend",
  "version": "1.0.0",
  "description": "Frontend Angular para Sistema Universal de Trazabilidad Industrial Multiproducto con Componentes Standalone y Signals",
  "private": true,
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --port 4200 --proxy-config proxy.conf.json",
    "start": "ng serve --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "dev:isolated": "ng serve --port 4201 --proxy-config proxy.isolated.conf.json"
  },
  "dependencies": {
    "@angular/animations": "^19.1.0",
    "@angular/common": "^19.1.0",
    "@angular/compiler": "^19.1.0",
    "@angular/core": "^19.1.0",
    "@angular/forms": "^19.1.0",
    "@angular/platform-browser": "^19.1.0",
    "@angular/router": "^19.1.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.1.0",
    "@angular/cli": "^19.1.0",
    "@angular/compiler-cli": "^19.1.0",
    "@types/node": "^24.15.0",
    "typescript": "~5.7.2"
  }
}
